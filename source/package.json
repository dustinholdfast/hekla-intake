  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 47231 --ip 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts",
