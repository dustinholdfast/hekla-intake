import { buildCreateFields, buildMergeFields, collectorVariants, dedupeKey, setIdentityOf, type DraftCard, type PrintingRef } from "./fields.ts";
import { LISTED_CAP, type Game, type Status, setName } from "./sets.ts";
export class AirtableError extends Error{status:number;constructor(message:string,status:number){super(message);this.name="AirtableError";this.status=status}}
type Rec={id:string;createdTime:string;fields:Record<string,unknown>};
export type QueueCard={id:string;name:string;cardName:string|null;resolvedName:string|null;game:string|null;setNumber:string|null;setIdentifier:string|null;setName:string|null;collectorNumber:string|null;finish:string|null;condition:string|null;qty:number;status:string|null;rankScore:number|null;marketPriceUsd:number|null;notes:string|null;priority:number|null;createdTime:string};
export type Summary={cap:number;listedQty:number;waitlistQty:number;remaining:number;counts:Record<string,number>;truncated:boolean};
const READ_FIELDS=["Card Name","Resolved Name","Game","Set #","Set Identifier","Collector Number","Finish","Condition","Qty","Status","Rank Score","Market Price USD","Notes","Priority"];
const MAX_PAGES=20;
function token(env:Env){const t=env.AIRTABLE_API_KEY?.trim()||env.AIRTABLE_PAT?.trim();if(!t)throw new AirtableError("Set AIRTABLE_API_KEY (or AIRTABLE_PAT) before intake can read or write.",503);return t}
function endpoint(env:Env){if(!env.AIRTABLE_BASE_ID||!env.AIRTABLE_TABLE_ID)throw new AirtableError("Airtable base/table IDs are not configured.",503);return `https://api.airtable.com/v0/${encodeURIComponent(env.AIRTABLE_BASE_ID)}/${encodeURIComponent(env.AIRTABLE_TABLE_ID)}`}
async function airtable(env:Env,url:string,init:RequestInit={}){const h=new Headers(init.headers);h.set("Authorization",`Bearer ${token(env)}`);if(init.body)h.set("Content-Type","application/json");let r:Response|null=null;for(let i=0;i<2;i++){r=await fetch(url,{...init,headers:h});if(r.status!==429)break;await r.body?.cancel();await new Promise(x=>setTimeout(x,400))}if(!r)throw new AirtableError("Airtable did not respond.",502);if(!r.ok){let d="";try{const b=await r.json() as any;d=typeof b.error==="string"?b.error:b.error?.message??""}catch{}await r.body?.cancel();if(r.status===401||r.status===403)throw new AirtableError("Airtable rejected the token. Check AIRTABLE_API_KEY scopes for this base.",502);throw new AirtableError(d?`Airtable: ${d}`:`Airtable request failed (${r.status}).`,r.status>=500?502:400)}return r.json()}
const txt=(v:unknown)=>typeof v==="string"&&v.trim()?v.trim():null;const num=(v:unknown)=>typeof v==="number"&&Number.isFinite(v)?v:null;
function toQueue(r:Rec):QueueCard{const f=r.fields||{};const game=txt(f.Game);const sn=txt(f["Set #"]);return{id:r.id,name:txt(f["Card Name"])||txt(f["Resolved Name"])||"",cardName:txt(f["Card Name"]),resolvedName:txt(f["Resolved Name"]),game,setNumber:sn,setIdentifier:txt(f["Set Identifier"]),setName:game==="Lorcana"?setName(sn):null,collectorNumber:txt(f["Collector Number"]),finish:txt(f.Finish),condition:txt(f.Condition),qty:num(f.Qty)??0,status:txt(f.Status),rankScore:num(f["Rank Score"]),marketPriceUsd:num(f["Market Price USD"]),notes:txt(f.Notes),priority:num(f.Priority),createdTime:r.createdTime}}
async function listRecords(env:Env,formula:string,fields:string[]=READ_FIELDS){const out:Rec[]=[];let offset:string|undefined;for(let page=0;page<MAX_PAGES;page++){const u=new URL(endpoint(env));u.searchParams.set("pageSize","100");u.searchParams.set("filterByFormula",formula);for(const f of fields)u.searchParams.append("fields[]",f);if(offset)u.searchParams.set("offset",offset);const b=await airtable(env,u.toString());out.push(...(b.records??[]));if(!b.offset)return{records:out,truncated:false};offset=b.offset}return{records:out,truncated:true}}
const formula=(x:string)=>`{${x.replace(/}/g,"\\}")}`;
export async function listByStatus(env:Env,status:Status){const x=await listRecords(env,`{Status}=${JSON.stringify(status)}`);return{cards:x.records.map(toQueue),truncated:x.truncated}}
export async function listOpenPrintings(env:Env){const x=await listRecords(env,`OR({Status}='Waitlist',{Status}='Listed')`);return x.records.map(toQueue)}
function key(c:PrintingRef){return dedupeKey(c.game??"",setIdentityOf(c),c.collectorNumber??"",c.finish??"")}
export function duplicatesAmong(cards:QueueCard[],draft:DraftCard){const d={game:draft.game,setNumber:draft.game==="Lorcana"?draft.setNumber:null,setIdentifier:draft.game==="Lorcana"?null:draft.setIdentifier,collectorNumber:draft.collectorNumber,finish:draft.finish};const k=key(d);return cards.filter(c=>(c.status==="Waitlist"||c.status==="Listed")&&key(c)===k)}
export async function findDuplicates(env:Env,card:DraftCard){return duplicatesAmong(await listOpenPrintings(env),card)}
export async function createCards(env:Env,cards:DraftCard[]){const made:QueueCard[]=[];for(let i=0;i<cards.length;i+=10){const records=await airtable(env,endpoint(env),{method:"POST",body:JSON.stringify({records:cards.slice(i,i+10).map(c=>({fields:buildCreateFields(c)})),typecast:false})});made.push(...(records.records??[]).map(toQueue))}return made}
export async function mergeQty(env:Env,id:string,addQty:number){if(!/^[recA-Za-z0-9]{14}$/.test(id))throw new AirtableError("That record id is not an Airtable row.",400);const r=await airtable(env,`${endpoint(env)}/${id}`) as Rec;const q=num(r.fields?.Qty)??0;const b=await airtable(env,`${endpoint(env)}/${id}`,{method:"PATCH",body:JSON.stringify({fields:buildMergeFields(q+addQty),typecast:false})}) as Rec;return toQueue(b)}
export async function summary(env:Env):Promise<Summary>{const x=await listRecords(env,"TRUE",["Status","Qty"]);const counts:Record<string,number>={Waitlist:0,Listed:0,Sold:0,Skip:0};let listedQty=0,waitlistQty=0;for(const r of x.records){const s=txt(r.fields.Status)||"";const q=num(r.fields.Qty)??0;if(s in counts)counts[s]=(counts[s]??0)+1;if(s==="Listed")listedQty+=q;if(s==="Waitlist")waitlistQty+=q}return{cap:LISTED_CAP,listedQty,waitlistQty,remaining:LISTED_CAP-listedQty,counts,truncated:x.truncated}}
export async function listOpenPrintingsForGame(env:Env,game:Game){return(await listOpenPrintings(env)).filter(x=>x.game===game)}
