index 0000000..f887b25
--- /dev/null
+++ b/src/hekla.ts
@@ -0,0 +1,50 @@
+import type { Env } from './db'
+
+// Sends each paid starfoil.store order to Hekla Intake's sales log. starfoil-lgs has
+// already lowered CardTrader and the Airtable Waitlist; Hekla only records the sale.
+// Hekla ignores a repeat of the same order and line, so a retry is harmless.
+
+export interface HeklaSaleItem { lineKey: string; recordId: string | null; game: string | null; name: string; qty: number; unitCents: number; stockResult: string | null }
+export interface HeklaSale {
+  orderId: string; paidAt: string; currency: string
+  subtotalCents: number | null; shippingCents: number | null; taxCents: number | null; totalCents: number | null
+  feeCents: number | null; items: HeklaSaleItem[]
+}
+
+const hex = (buf: ArrayBuffer) => [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('')
+
+export async function postSaleToHekla(env: Env, sale: HeklaSale): Promise<string> {
+  if (!env.HEKLA_SALES_URL || !env.HEKLA_SALES_SECRET) return 'hekla: not configured'
+  // Same rule as stock write-back: test-mode payments are never reported as sales.
+  if (!env.STRIPE_SECRET_KEY?.startsWith('sk_live_')) return 'hekla: test mode, not sent'
+  const body = JSON.stringify(sale)
+  const timestamp = String(Math.floor(Date.now() / 1000))
+  const key = await crypto.subtle.importKey('raw', new TextEncoder().encode(env.HEKLA_SALES_SECRET), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign'])
+  const signature = hex(await crypto.subtle.sign('HMAC', key, new TextEncoder().encode(`${timestamp}.${body}`)))
+  const res = await fetch(env.HEKLA_SALES_URL, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json', 'x-hekla-timestamp': timestamp, 'x-hekla-signature': signature },
+    body,
+    signal: AbortSignal.timeout(8000),
+  })
+  await res.body?.cancel()
+  if (!res.ok) throw new Error(`hekla ${res.status}`)
+  return 'hekla: logged'
+}
+
+// The Stripe processing fee for a payment, when Stripe has settled it. Best effort.
+export async function stripeFeeCents(env: Env, paymentIntent: string | null | undefined): Promise<number | null> {
+  if (!paymentIntent || !env.STRIPE_SECRET_KEY) return null
+  try {
+    const res = await fetch(`https://api.stripe.com/v1/payment_intents/${encodeURIComponent(paymentIntent)}?expand[]=latest_charge.balance_transaction`, {
+      headers: { Authorization: `Bearer ${env.STRIPE_SECRET_KEY}` }, signal: AbortSignal.timeout(5000),
+    })
+    if (!res.ok) { await res.body?.cancel(); return null }
+    const pi = await res.json<{ latest_charge?: { balance_transaction?: { fee?: number } | string | null } | string | null }>()
+    const charge = typeof pi.latest_charge === 'object' ? pi.latest_charge : null
+    const bt = charge && typeof charge.balance_transaction === 'object' ? charge.balance_transaction : null
+    return typeof bt?.fee === 'number' ? bt.fee : null
+  } catch {
+    return null
+  }
+}
